# UniAssist Environment Configuration

# Service Ports & Hosts
RAG_SERVICE_URL=http://localhost:8001
OLLAMA_SERVICE_URL=http://localhost:11434
APP_PORT=8000
RAG_PORT=8001

# LLM Models Configuration
# Recommended for Small AWS Server (1GB - 2GB RAM):
# 1. qwen2.5:0.5b  (~390MB)
# 2. tinyllama     (~630MB)
# 3. qwen2.5:1.5b  (~980MB)
DEFAULT_MODEL=qwen2.5:0.5b

# RAG Configuration
CHUNK_SIZE=600
CHUNK_OVERLAP=120
DEFAULT_TOP_K=3
MIN_SIMILARITY_THRESHOLD=0.05
